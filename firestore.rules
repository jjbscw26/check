rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Global Primitives
    function isValidId(id) {
      return id is string &&
        id.size() >= 1 &&
        id.size() <= 128 &&
        id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isBootstrappedAdmin() {
      return isSignedIn() &&
        request.auth.token.email_verified == true &&
        request.auth.token.email is string &&
        request.auth.token.email.size() <= 254 &&
        request.auth.token.email == 'jjbscw@gmail.com';
    }

    function isValidWorkspaceEpoch(ts) {
      return ts is timestamp && ts >= timestamp.date(2020, 1, 1);
    }

    // Shared Audit Metadata Validator (supports automatic login-free device sync)
    function hasValidAuditMetadata(data) {
      return data.createdByUid is string &&
        data.createdByUid.size() >= 1 &&
        data.createdByUid.size() <= 128 &&
        data.createdByUid.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.createdByEmail is string &&
        data.createdByEmail.size() >= 5 &&
        data.createdByEmail.size() <= 254 &&
        data.createdByEmail.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]{2,}$') &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // Blueprint Validation Helpers (synchronized verbatim with firebase-blueprint.json)
    function isValidStructuredAddress(addr) {
      return addr is map &&
        addr.keys().hasAll(['street', 'number', 'city', 'state', 'postalCode']) &&
        addr.keys().hasOnly(['street', 'number', 'city', 'state', 'postalCode']) &&
        addr.street is string &&
        addr.street.size() >= 1 &&
        addr.street.size() <= 150 &&
        addr.street.matches('^\\S(.*\\S)?$') &&
        addr.number is string &&
        addr.number.size() >= 1 &&
        addr.number.size() <= 30 &&
        addr.number.matches('^\\S(.*\\S)?$') &&
        addr.city is string &&
        addr.city.size() >= 1 &&
        addr.city.size() <= 100 &&
        addr.city.matches('^\\S(.*\\S)?$') &&
        addr.state is string &&
        addr.state.size() >= 1 &&
        addr.state.size() <= 100 &&
        addr.state.matches('^\\S(.*\\S)?$') &&
        addr.postalCode is string &&
        addr.postalCode.size() >= 4 &&
        addr.postalCode.size() <= 10 &&
        addr.postalCode.matches('^[A-Za-z0-9][A-Za-z0-9\\- ]{2,8}[A-Za-z0-9]$');
    }

    function isValidDateStringList(arr) {
      return arr is list &&
        arr.size() <= 366 && (
          arr.size() == 0 || (
            arr[0] is string &&
            arr[0].size() == 10 &&
            arr[0].matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          )
        );
    }

    // 1. Trainer Schema Validator (/trainers/{trainerId})
    function isValidTrainer(data) {
      return data is map &&
        data.keys().hasAll([
          'name',
          'email',
          'phone',
          'avatar',
          'specialties',
          'active',
          'createdByUid',
          'createdByEmail',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'name',
          'email',
          'phone',
          'avatar',
          'specialties',
          'active',
          'createdByUid',
          'createdByEmail',
          'createdAt',
          'updatedAt'
        ]) &&
        data.name is string &&
        data.name.size() >= 2 &&
        data.name.size() <= 120 &&
        data.name.matches('^\\S(.*\\S)?$') &&
        data.email is string &&
        data.email.size() >= 5 &&
        data.email.size() <= 254 &&
        data.email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]{2,}$') &&
        data.phone is string &&
        data.phone.size() >= 7 &&
        data.phone.size() <= 25 &&
        data.phone.matches('^[0-9+(][0-9+()\\- ]{5,23}[0-9)]$') &&
        data.avatar is string &&
        data.avatar.size() >= 5 &&
        data.avatar.size() <= 150000 &&
        data.avatar.matches('^(https?://\\S+|data:image/[a-zA-Z0-9.+\\-]+;\\S+)$') &&
        data.specialties is list &&
        data.specialties.size() >= 1 &&
        data.specialties.size() <= 20 &&
        data.specialties[0] is string &&
        data.specialties[0].size() >= 1 &&
        data.specialties[0].size() <= 80 &&
        data.specialties[0].matches('^\\S(.*\\S)?$') &&
        data.active is bool &&
        hasValidAuditMetadata(data);
    }

    // 2. Company Schema Validator (/companies/{companyId})
    function isValidCompany(data) {
      return data is map &&
        data.keys().hasAll([
          'name',
          'taxId',
          'industry',
          'logoText',
          'createdByUid',
          'createdByEmail',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'name',
          'taxId',
          'industry',
          'logoText',
          'companyName',
          'phone',
          'primaryContactName',
          'address',
          'createdByUid',
          'createdByEmail',
          'createdAt',
          'updatedAt'
        ]) &&
        data.name is string &&
        data.name.size() >= 2 &&
        data.name.size() <= 150 &&
        data.name.matches('^\\S(.*\\S)?$') &&
        data.taxId is string &&
        data.taxId.size() >= 5 &&
        data.taxId.size() <= 25 &&
        data.taxId.matches('^[A-Za-z0-9&Ññ][A-Za-z0-9&Ññ.\\- ]{3,23}[A-Za-z0-9&Ññ]$') &&
        data.industry is string &&
        data.industry.size() >= 2 &&
        data.industry.size() <= 100 &&
        data.industry.matches('^\\S(.*\\S)?$') &&
        data.logoText is string &&
        data.logoText.size() >= 1 &&
        data.logoText.size() <= 4 &&
        data.logoText.matches('^[A-Za-z0-9&Ññ]{1,4}$') &&
        (
          !('companyName' in data) || (
            data.companyName is string &&
            data.companyName.size() >= 2 &&
            data.companyName.size() <= 150 &&
            data.companyName.matches('^\\S(.*\\S)?$')
          )
        ) &&
        (
          !('phone' in data) || (
            data.phone is string &&
            data.phone.size() <= 25 &&
            (data.phone.size() == 0 || data.phone.matches('^[0-9+(][0-9+()\\- ]{5,23}[0-9)]$'))
          )
        ) &&
        (
          !('primaryContactName' in data) || (
            data.primaryContactName is string &&
            data.primaryContactName.size() <= 120 &&
            (data.primaryContactName.size() == 0 || data.primaryContactName.matches('^\\S(.*\\S)?$'))
          )
        ) &&
        (
          !('address' in data) || isValidStructuredAddress(data.address)
        ) &&
        hasValidAuditMetadata(data);
    }

    // 3. Sede Schema Validator (/sedes/{sedeId})
    function isValidSede(data) {
      return data is map &&
        data.keys().hasAll([
          'companyId',
          'companyName',
          'name',
          'address',
          'city',
          'lat',
          'lng',
          'geofenceRadiusMeters',
          'contactPerson',
          'contactRole',
          'contactPhone',
          'createdByUid',
          'createdByEmail',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'companyId',
          'companyName',
          'name',
          'address',
          'city',
          'lat',
          'lng',
          'geofenceRadiusMeters',
          'contactPerson',
          'contactRole',
          'contactPhone',
          'colorTag',
          'createdByUid',
          'createdByEmail',
          'createdAt',
          'updatedAt'
        ]) &&
        isValidId(data.companyId) &&
        data.companyName is string &&
        data.companyName.size() >= 2 &&
        data.companyName.size() <= 150 &&
        data.companyName.matches('^\\S(.*\\S)?$') &&
        data.name is string &&
        data.name.size() >= 2 &&
        data.name.size() <= 150 &&
        data.name.matches('^\\S(.*\\S)?$') &&
        data.address is string &&
        data.address.size() >= 3 &&
        data.address.size() <= 250 &&
        data.address.matches('^\\S(.*\\S)?$') &&
        data.city is string &&
        data.city.size() >= 2 &&
        data.city.size() <= 100 &&
        data.city.matches('^\\S(.*\\S)?$') &&
        data.lat is number &&
        !isNaN(data.lat) &&
        data.lat >= -90 &&
        data.lat <= 90 &&
        data.lng is number &&
        !isNaN(data.lng) &&
        data.lng >= -180 &&
        data.lng <= 180 &&
        data.geofenceRadiusMeters is number &&
        !isNaN(data.geofenceRadiusMeters) &&
        data.geofenceRadiusMeters >= 10 &&
        data.geofenceRadiusMeters <= 10000 &&
        data.contactPerson is string &&
        data.contactPerson.size() >= 2 &&
        data.contactPerson.size() <= 120 &&
        data.contactPerson.matches('^\\S(.*\\S)?$') &&
        data.contactRole is string &&
        data.contactRole.size() >= 2 &&
        data.contactRole.size() <= 120 &&
        data.contactRole.matches('^\\S(.*\\S)?$') &&
        data.contactPhone is string &&
        data.contactPhone.size() >= 7 &&
        data.contactPhone.size() <= 25 &&
        data.contactPhone.matches('^[0-9+(][0-9+()\\- ]{5,23}[0-9)]$') &&
        (
          !('colorTag' in data) || (
            data.colorTag is string &&
            data.colorTag.size() <= 40 &&
            (data.colorTag.size() == 0 || data.colorTag.matches('^[a-zA-Z0-9_\\-]+$'))
          )
        ) &&
        hasValidAuditMetadata(data);
    }

    // 4. ClassAssignment Schema Validator (/assignments/{assignmentId})
    function isValidAssignment(data) {
      return data is map &&
        data.keys().hasAll([
          'trainerId',
          'trainerName',
          'companyId',
          'companyName',
          'sedeId',
          'sedeName',
          'sedeAddress',
          'frequency',
          'time',
          'activityType',
          'activityName',
          'locationArea',
          'active',
          'createdByUid',
          'createdByEmail',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'trainerId',
          'trainerName',
          'companyId',
          'companyName',
          'sedeId',
          'sedeName',
          'sedeAddress',
          'frequency',
          'dayOfWeek',
          'date',
          'dayOfMonth',
          'time',
          'durationMinutes',
          'activityType',
          'activityName',
          'locationArea',
          'expectedAttendees',
          'notes',
          'active',
          'closed',
          'closedAt',
          'completedDates',
          'nonCompliant',
          'nonCompliantReason',
          'nonCompliantAt',
          'missedDates',
          'reopenedDates',
          'createdByUid',
          'createdByEmail',
          'createdAt',
          'updatedAt'
        ]) &&
        isValidId(data.trainerId) &&
        data.trainerName is string &&
        data.trainerName.size() >= 2 &&
        data.trainerName.size() <= 120 &&
        data.trainerName.matches('^\\S(.*\\S)?$') &&
        isValidId(data.companyId) &&
        data.companyName is string &&
        data.companyName.size() >= 2 &&
        data.companyName.size() <= 150 &&
        data.companyName.matches('^\\S(.*\\S)?$') &&
        isValidId(data.sedeId) &&
        data.sedeName is string &&
        data.sedeName.size() >= 2 &&
        data.sedeName.size() <= 150 &&
        data.sedeName.matches('^\\S(.*\\S)?$') &&
        data.sedeAddress is string &&
        data.sedeAddress.size() >= 2 &&
        data.sedeAddress.size() <= 250 &&
        data.sedeAddress.matches('^\\S(.*\\S)?$') &&
        data.frequency is string &&
        data.frequency.size() <= 20 &&
        data.frequency in ['semanal', 'mensual', 'fecha_unica'] &&
        data.time is string &&
        data.time.size() == 5 &&
        data.time.matches('^[0-2][0-9]:[0-5][0-9]$') &&
        data.activityType is string &&
        data.activityType.size() <= 20 &&
        data.activityType in ['pausa_activa', 'clase_fitness'] &&
        data.activityName is string &&
        data.activityName.size() >= 2 &&
        data.activityName.size() <= 150 &&
        data.activityName.matches('^\\S(.*\\S)?$') &&
        data.locationArea is string &&
        data.locationArea.size() >= 1 &&
        data.locationArea.size() <= 150 &&
        data.locationArea.matches('^\\S(.*\\S)?$') &&
        data.active is bool &&
        (
          !('dayOfWeek' in data) || (
            data.dayOfWeek is number &&
            !isNaN(data.dayOfWeek) &&
            data.dayOfWeek >= 0 &&
            data.dayOfWeek <= 6
          )
        ) &&
        (
          !('date' in data) || (
            data.date is string &&
            data.date.size() == 10 &&
            data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          )
        ) &&
        (
          !('dayOfMonth' in data) || (
            data.dayOfMonth is number &&
            !isNaN(data.dayOfMonth) &&
            data.dayOfMonth >= 1 &&
            data.dayOfMonth <= 31
          )
        ) &&
        (
          !('durationMinutes' in data) || (
            data.durationMinutes is number &&
            !isNaN(data.durationMinutes) &&
            data.durationMinutes >= 5 &&
            data.durationMinutes <= 480
          )
        ) &&
        (
          !('expectedAttendees' in data) || (
            data.expectedAttendees is number &&
            !isNaN(data.expectedAttendees) &&
            data.expectedAttendees >= 0 &&
            data.expectedAttendees <= 5000
          )
        ) &&
        (
          !('notes' in data) || (
            data.notes is string &&
            data.notes.size() <= 500
          )
        ) &&
        (
          !('closed' in data) || data.closed is bool
        ) &&
        (
          !('closedAt' in data) || (
            data.closedAt is string &&
            data.closedAt.size() <= 40
          )
        ) &&
        (
          !('completedDates' in data) || isValidDateStringList(data.completedDates)
        ) &&
        (
          !('nonCompliant' in data) || data.nonCompliant is bool
        ) &&
        (
          !('nonCompliantReason' in data) || (
            data.nonCompliantReason is string &&
            data.nonCompliantReason.size() <= 30 &&
            data.nonCompliantReason in ['fuera_de_horario', 'sin_cierre_30m', 'manual_admin']
          )
        ) &&
        (
          !('nonCompliantAt' in data) || (
            data.nonCompliantAt is string &&
            data.nonCompliantAt.size() <= 40
          )
        ) &&
        (
          !('missedDates' in data) || isValidDateStringList(data.missedDates)
        ) &&
        (
          !('reopenedDates' in data) || isValidDateStringList(data.reopenedDates)
        ) &&
        hasValidAuditMetadata(data);
    }

    // Relational parent checks (evaluated AFTER static validation)
    function parentCompanyExists(companyId) {
      return exists(/databases/$(database)/documents/companies/$(companyId));
    }

    function parentCompanyAndSedeExist(companyId, sedeId) {
      return exists(/databases/$(database)/documents/companies/$(companyId)) &&
        exists(/databases/$(database)/documents/sedes/$(sedeId));
    }

    // 5. Personnel Schema Validator (/personnel/{personnelId})
    function isValidPersonnel(data) {
      return data is map &&
        data.keys().hasAll([
          'fullName',
          'phone',
          'email',
          'address',
          'createdByUid',
          'createdByEmail',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'fullName',
          'phone',
          'email',
          'address',
          'createdByUid',
          'createdByEmail',
          'createdAt',
          'updatedAt'
        ]) &&
        data.fullName is string &&
        data.fullName.size() >= 2 &&
        data.fullName.size() <= 120 &&
        data.fullName.matches('^\\S(.*\\S)?$') &&
        data.phone is string &&
        data.phone.size() >= 7 &&
        data.phone.size() <= 25 &&
        data.phone.matches('^[0-9+(][0-9+()\\- ]{5,23}[0-9)]$') &&
        data.email is string &&
        data.email.size() >= 5 &&
        data.email.size() <= 254 &&
        data.email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]{2,}$') &&
        isValidStructuredAddress(data.address) &&
        hasValidAuditMetadata(data);
    }

    // 6. Client Schema Validator (/clients/{clientId})
    function isValidClient(data) {
      return data is map &&
        data.keys().hasAll([
          'fullName',
          'phone',
          'email',
          'address',
          'createdByUid',
          'createdByEmail',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'fullName',
          'phone',
          'email',
          'address',
          'company',
          'createdByUid',
          'createdByEmail',
          'createdAt',
          'updatedAt'
        ]) &&
        data.fullName is string &&
        data.fullName.size() >= 2 &&
        data.fullName.size() <= 120 &&
        data.fullName.matches('^\\S(.*\\S)?$') &&
        data.phone is string &&
        data.phone.size() >= 7 &&
        data.phone.size() <= 25 &&
        data.phone.matches('^[0-9+(][0-9+()\\- ]{5,23}[0-9)]$') &&
        data.email is string &&
        data.email.size() >= 5 &&
        data.email.size() <= 254 &&
        data.email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]{2,}$') &&
        isValidStructuredAddress(data.address) &&
        (
          !('company' in data) || (
            data.company is string &&
            data.company.size() <= 150 &&
            (data.company.size() == 0 || data.company.matches('^\\S(.*\\S)?$'))
          )
        ) &&
        hasValidAuditMetadata(data);
    }

    function isValidAdminRole(data) {
      return data is map &&
        data.keys().hasAll(['email', 'grantedAt']) &&
        data.keys().hasOnly(['email', 'grantedAt']) &&
        data.email is string &&
        data.email.size() >= 5 &&
        data.email.size() <= 254 &&
        data.email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]{2,}$') &&
        data.grantedAt is timestamp;
    }

    // Collection 1: /trainers/{trainerId}
    match /trainers/{trainerId} {
      allow get: if isValidId(trainerId) &&
        (resource == null || isValidWorkspaceEpoch(existing().createdAt));

      allow list: if resource.data.createdAt >= timestamp.date(2020, 1, 1);

      allow create: if isValidId(trainerId) &&
        isValidTrainer(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if (
        isValidId(trainerId) &&
        isValidTrainer(incoming()) &&
        incoming().createdByUid == existing().createdByUid &&
        incoming().createdByEmail == existing().createdByEmail &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'name',
          'email',
          'phone',
          'avatar',
          'specialties',
          'active',
          'updatedAt'
        ])
      );

      allow delete: if isValidId(trainerId) &&
        resource != null &&
        isValidWorkspaceEpoch(existing().createdAt);
    }

    // Collection 2: /companies/{companyId}
    match /companies/{companyId} {
      allow get: if isValidId(companyId) &&
        (resource == null || isValidWorkspaceEpoch(existing().createdAt));

      allow list: if resource.data.createdAt >= timestamp.date(2020, 1, 1);

      allow create: if isValidId(companyId) &&
        isValidCompany(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if (
        isValidId(companyId) &&
        isValidCompany(incoming()) &&
        incoming().createdByUid == existing().createdByUid &&
        incoming().createdByEmail == existing().createdByEmail &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'name',
          'taxId',
          'industry',
          'logoText',
          'companyName',
          'phone',
          'primaryContactName',
          'address',
          'updatedAt'
        ])
      );

      allow delete: if isValidId(companyId) &&
        resource != null &&
        isValidWorkspaceEpoch(existing().createdAt);
    }

    // Collection 3: /sedes/{sedeId}
    match /sedes/{sedeId} {
      allow get: if isValidId(sedeId) &&
        (resource == null || isValidWorkspaceEpoch(existing().createdAt));

      allow list: if resource.data.createdAt >= timestamp.date(2020, 1, 1);

      allow create: if isValidId(sedeId) &&
        isValidSede(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        parentCompanyExists(incoming().companyId);

      allow update: if (
        isValidId(sedeId) &&
        isValidSede(incoming()) &&
        incoming().createdByUid == existing().createdByUid &&
        incoming().createdByEmail == existing().createdByEmail &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'companyId',
          'companyName',
          'name',
          'address',
          'city',
          'lat',
          'lng',
          'geofenceRadiusMeters',
          'contactPerson',
          'contactRole',
          'contactPhone',
          'colorTag',
          'updatedAt'
        ]) &&
        parentCompanyExists(incoming().companyId)
      );

      allow delete: if isValidId(sedeId) &&
        resource != null &&
        isValidWorkspaceEpoch(existing().createdAt);
    }

    // Collection 4: /assignments/{assignmentId}
    match /assignments/{assignmentId} {
      allow get: if isValidId(assignmentId) &&
        (resource == null || isValidWorkspaceEpoch(existing().createdAt));

      allow list: if resource.data.createdAt >= timestamp.date(2020, 1, 1);

      allow create: if isValidId(assignmentId) &&
        isValidAssignment(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        parentCompanyAndSedeExist(incoming().companyId, incoming().sedeId);

      allow update: if (
        isValidId(assignmentId) &&
        isValidAssignment(incoming()) &&
        incoming().createdByUid == existing().createdByUid &&
        incoming().createdByEmail == existing().createdByEmail &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'trainerId',
          'trainerName',
          'companyId',
          'companyName',
          'sedeId',
          'sedeName',
          'sedeAddress',
          'frequency',
          'dayOfWeek',
          'date',
          'dayOfMonth',
          'time',
          'durationMinutes',
          'activityType',
          'activityName',
          'locationArea',
          'expectedAttendees',
          'notes',
          'active',
          'closed',
          'closedAt',
          'completedDates',
          'nonCompliant',
          'nonCompliantReason',
          'nonCompliantAt',
          'missedDates',
          'reopenedDates',
          'updatedAt'
        ]) &&
        parentCompanyAndSedeExist(incoming().companyId, incoming().sedeId)
      );

      allow delete: if isValidId(assignmentId) &&
        resource != null &&
        isValidWorkspaceEpoch(existing().createdAt);
    }

    // Collection 5: /personnel/{personnelId}
    match /personnel/{personnelId} {
      allow get: if isValidId(personnelId) &&
        (resource == null || isValidWorkspaceEpoch(existing().createdAt));

      allow list: if resource.data.createdAt >= timestamp.date(2020, 1, 1);

      allow create: if isValidId(personnelId) &&
        isValidPersonnel(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if (
        isValidId(personnelId) &&
        isValidPersonnel(incoming()) &&
        incoming().createdByUid == existing().createdByUid &&
        incoming().createdByEmail == existing().createdByEmail &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'fullName',
          'phone',
          'email',
          'address',
          'updatedAt'
        ])
      );

      allow delete: if isValidId(personnelId) &&
        resource != null &&
        isValidWorkspaceEpoch(existing().createdAt);
    }

    // Collection 6: /clients/{clientId}
    match /clients/{clientId} {
      allow get: if isValidId(clientId) &&
        (resource == null || isValidWorkspaceEpoch(existing().createdAt));

      allow list: if resource.data.createdAt >= timestamp.date(2020, 1, 1);

      allow create: if isValidId(clientId) &&
        isValidClient(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if (
        isValidId(clientId) &&
        isValidClient(incoming()) &&
        incoming().createdByUid == existing().createdByUid &&
        incoming().createdByEmail == existing().createdByEmail &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'fullName',
          'phone',
          'email',
          'address',
          'company',
          'updatedAt'
        ])
      );

      allow delete: if isValidId(clientId) &&
        resource != null &&
        isValidWorkspaceEpoch(existing().createdAt);
    }

    // Collection 7: /admins/{adminUid}
    match /admins/{adminUid} {
      allow get: if isBootstrappedAdmin() && isValidId(adminUid);

      allow list: if false;

      allow create: if isBootstrappedAdmin() &&
        isValidId(adminUid) &&
        isValidAdminRole(incoming()) &&
        incoming().grantedAt == request.time;

      allow update: if false;

      allow delete: if isBootstrappedAdmin() &&
        isValidId(adminUid);
    }
  }
}
