          "maxLength": 120,
          "pattern": "^\\S(.*\\S)?$"
        },
        "contactPhone": {
          "type": "string",
          "description": "Teléfono directo del contacto en sede.",
          "minLength": 7,
          "maxLength": 25,
          "pattern": "^[0-9+(][0-9+()\\- ]{5,23}[0-9)]$"
        },
        "colorTag": {
          "type": "string",
          "description": "Clase o identificador visual de color para la sede.",
          "minLength": 0,
          "maxLength": 40,
          "pattern": "^([a-zA-Z0-9_\\-]+)?$"
        },
        "createdByUid": {
          "type": "string",
          "description": "Identificador persistente del dispositivo o cliente origen que creó el registro.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdByEmail": {
          "type": "string",
          "format": "email",
          "description": "Correo técnico o corporativo de auditoría del registro.",
          "minLength": 5,
          "maxLength": 254,
          "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]{2,}$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Marca de tiempo generada por el servidor al crear el documento."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Marca de tiempo generada por el servidor en la última actualización."
        }
      },
