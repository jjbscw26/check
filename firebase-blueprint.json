          "minLength": 1,
          "maxLength": 4,
          "pattern": "^[A-Za-z0-9&Ññ]{1,4}$"
        },
        "companyName": {
          "type": "string",
          "description": "Alias opcional de razón social para compatibilidad de directorio.",
          "minLength": 2,
          "maxLength": 150,
          "pattern": "^\\S(.*\\S)?$"
        },
        "phone": {
          "type": "string",
          "description": "Teléfono corporativo opcional de la empresa.",
          "minLength": 0,
          "maxLength": 25
        },
        "primaryContactName": {
          "type": "string",
          "description": "Contacto corporativo principal opcional.",
          "minLength": 0,
          "maxLength": 120
        },
        "address": {
          "type": "object",
          "$ref": "#/entities/StructuredAddress",
          "description": "Dirección fiscal estructurada opcional de la empresa."
        },
        "createdByUid": {
          "type": "string",
          "description": "Identificador persistente del dispositivo o cliente origen que creó el registro.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdByEmail": {
          "type": "string",
          "format": "email",
          "description": "Correo técnico o corporativo de auditoría del registro.",
          "minLength": 5,
          "maxLength": 254,
          "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]{2,}$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Marca de tiempo generada por el servidor al crear el documento."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Marca de tiempo generada por el servidor en la última actualización."
        }
      },
      "required": [
        "name",
        "taxId",
        "industry",
        "logoText",
        "createdByUid",
        "createdByEmail",
        "createdAt",
        "updatedAt"
      ]
    },
    "Sede": {
      "title": "Sede",
      "description": "Sede / Campus / Planta autorizada de una empresa cliente con coordenadas GPS, geocerca y contacto.",
      "type": "object",
      "properties": {
        "companyId": {
          "type": "string",
          "description": "Identificador de la empresa propietaria en /companies/{companyId}.",
