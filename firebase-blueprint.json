  "firestore": {
    "/trainers/{trainerId}": {
      "schema": {
        "$ref": "#/entities/Trainer"
      },
      "description": "Colección compartida de entrenadores corporativos conectada automáticamente desde cualquier dispositivo."
    },
    "/companies/{companyId}": {
      "schema": {
        "$ref": "#/entities/Company"
      },
      "description": "Colección compartida de empresas cliente conectada automáticamente desde cualquier dispositivo."
    },
    "/sedes/{sedeId}": {
      "schema": {
        "$ref": "#/entities/Sede"
      },
      "description": "Colección compartida de sedes / sucursales corporativas con coordenadas GPS y radio de geocerca."
    },
    "/assignments/{assignmentId}": {
      "schema": {
        "$ref": "#/entities/ClassAssignment"
      },
      "description": "Colección compartida de asignaciones programadas de clases y pausas activas sincronizada entre escritorio, tablets y celulares."
    },
    "/personnel/{personnelId}": {
      "schema": {
        "$ref": "#/entities/Personnel"
      },
      "description": "Colección compartida de expedientes de personal."
    },
    "/clients/{clientId}": {
      "schema": {
        "$ref": "#/entities/Client"
      },
      "description": "Colección compartida de expedientes de clientes con dirección residencial y empresa opcional."
    },
    "/admins/{adminUid}": {
      "schema": {
        "$ref": "#/entities/AdminRole"
      },
      "description": "Colección bloqueada de roles administrativos."
    }
  }
