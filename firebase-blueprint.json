{
  "entities": {
    "StructuredAddress": {
      "title": "StructuredAddress",
      "description": "Dirección física estructurada (Calle, Número, Ciudad, Estado, Código Postal) utilizada en Personal, Clientes y Empresas.",
      "type": "object",
      "properties": {
        "street": {
          "type": "string",
          "description": "Calle del domicilio.",
          "minLength": 1,
          "maxLength": 150,
          "pattern": "^\\S(.*\\S)?$"
        },
        "number": {
          "type": "string",
          "description": "Número exterior e interior del domicilio.",
          "minLength": 1,
          "maxLength": 30,
          "pattern": "^\\S(.*\\S)?$"
        },
        "city": {
          "type": "string",
          "description": "Ciudad, alcaldía o municipio.",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^\\S(.*\\S)?$"
        },
        "state": {
          "type": "string",
          "description": "Estado o entidad federativa.",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^\\S(.*\\S)?$"
        },
        "postalCode": {
          "type": "string",
          "description": "Código postal del domicilio.",
          "minLength": 4,
          "maxLength": 10,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9\\- ]{2,8}[A-Za-z0-9]$"
        }
      },
      "required": ["street", "number", "city", "state", "postalCode"]
    },
    "GpsData": {
      "title": "GpsData",
      "description": "Coordenadas GPS certificadas de check-in o check-out y validación contra la geocerca de la sede.",
      "type": "object",
      "properties": {
        "lat": {
          "type": "number",
          "description": "Latitud GPS (-90 a 90)."
        },
        "lng": {
          "type": "number",
          "description": "Longitud GPS (-180 a 180)."
        },
        "accuracy": {
          "type": "number",
          "description": "Precisión del GPS en metros."
        },
        "distanceToSedeMeters": {
          "type": "number",
          "description": "Distancia calculada a la sede en metros."
        },
        "isWithinGeofence": {
          "type": "boolean",
          "description": "Indica si la captura ocurrió dentro del radio permitido."
        },
        "capturedAt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50
        }
      },
      "required": [
        "lat",
        "lng",
        "accuracy",
        "distanceToSedeMeters",
        "isWithinGeofence",
        "capturedAt"
      ]
    },
    "FacialVerificationData": {
      "title": "FacialVerificationData",
      "description": "Metadatos y evidencia biométrica de verificación facial del entrenador.",
      "type": "object",
      "properties": {
        "verified": {
          "type": "boolean"
        },
        "confidenceScore": {
          "type": "number"
        },
        "facePhotoUrl": {
          "type": "string",
          "minLength": 5,
          "maxLength": 250000
        },
        "capturedAt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50
        },
        "biometricId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "livenessPassed": {
          "type": "boolean"
        },
        "trainerName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        }
      },
      "required": [
        "verified",
        "confidenceScore",
        "facePhotoUrl",
        "capturedAt",
        "biometricId",
        "livenessPassed",
        "trainerName"
      ]
    },
    "Trainer": {
      "title": "Trainer",
      "description": "Entrenador / Coach corporativo con conexión automática multi-dispositivo: nombre, correo, teléfono, avatar (URL o DataURL), especialidades y estado activo.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Nombre completo del entrenador.",
          "minLength": 2,
          "maxLength": 120,
          "pattern": "^\\S(.*\\S)?$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Correo electrónico corporativo del entrenador.",
          "minLength": 5,
          "maxLength": 254,
          "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]{2,}$"
        },
        "phone": {
          "type": "string",
          "description": "Número telefónico de contacto del entrenador.",
          "minLength": 7,
          "maxLength": 25,
          "pattern": "^[0-9+(][0-9+()\\- ]{5,23}[0-9)]$"
        },
        "avatar": {
          "type": "string",
          "description": "Fotografía de referencia o avatar del entrenador (URL HTTPS o imagen DataURL comprimida).",
          "minLength": 5,
          "maxLength": 150000,
          "pattern": "^(https?://\\S+|data:image/[a-zA-Z0-9.+\\-]+;\\S+)$"
        },
        "specialties": {
          "type": "array",
          "description": "Lista acotada de especialidades y disciplinas del entrenador (1 a 20 elementos)."
        },
        "active": {
          "type": "boolean",
          "description": "Indica si el entrenador está habilitado para visitas y clases."
        },
        "createdByUid": {
          "type": "string",
          "description": "Identificador persistente del dispositivo o cliente origen que creó el registro.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdByEmail": {
          "type": "string",
          "format": "email",
          "description": "Correo técnico o corporativo de auditoría del registro.",
          "minLength": 5,
          "maxLength": 254,
          "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]{2,}$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Marca de tiempo generada por el servidor al crear el documento."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Marca de tiempo generada por el servidor en la última actualización."
        }
      },
      "required": [
        "name",
        "email",
        "phone",
        "avatar",
        "specialties",
        "active",
        "createdByUid",
        "createdByEmail",
        "createdAt",
        "updatedAt"
      ]
    },
    "Company": {
      "title": "Company",
