{
  "entities": {
    "StructuredAddress": {
      "title": "StructuredAddress",
      "description": "Dirección física estructurada (Calle, Número, Ciudad, Estado, Código Postal) utilizada en Personal, Clientes y Empresas.",
      "type": "object",
      "properties": {
        "street": {
          "type": "string",
          "description": "Calle del domicilio.",
          "minLength": 1,
          "maxLength": 150,
          "pattern": "^\\S(.*\\S)?$"
        },
        "number": {
          "type": "string",
          "description": "Número exterior e interior del domicilio.",
          "minLength": 1,
          "maxLength": 30,
          "pattern": "^\\S(.*\\S)?$"
        },
        "city": {
          "type": "string",
          "description": "Ciudad, alcaldía o municipio.",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^\\S(.*\\S)?$"
        },
        "state": {
          "type": "string",
          "description": "Estado o entidad federativa.",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^\\S(.*\\S)?$"
        },
        "postalCode": {
          "type": "string",
          "description": "Código postal del domicilio.",
          "minLength": 4,
          "maxLength": 10,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9\\- ]{2,8}[A-Za-z0-9]$"
        }
      },
      "required": ["street", "number", "city", "state", "postalCode"]
    },
    "Trainer": {
      "title": "Trainer",
      "description": "Entrenador / Coach corporativo con conexión automática multi-dispositivo: nombre, correo, teléfono, avatar (URL o DataURL), especialidades y estado activo.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Nombre completo del entrenador.",
          "minLength": 2,
          "maxLength": 120,
          "pattern": "^\\S(.*\\S)?$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Correo electrónico corporativo del entrenador.",
          "minLength": 5,
          "maxLength": 254,
          "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]{2,}$"
        },
        "phone": {
          "type": "string",
          "description": "Número telefónico de contacto del entrenador.",
          "minLength": 7,
          "maxLength": 25,
          "pattern": "^[0-9+(][0-9+()\\- ]{5,23}[0-9)]$"
        },
        "avatar": {
          "type": "string",
          "description": "Fotografía de referencia o avatar del entrenador (URL HTTPS o imagen DataURL comprimida).",
          "minLength": 5,
          "maxLength": 150000,
          "pattern": "^(https?://\\S+|data:image/[a-zA-Z0-9.+\\-]+;\\S+)$"
        },
        "specialties": {
          "type": "array",
          "description": "Lista acotada de especialidades y disciplinas del entrenador (1 a 20 elementos).",
          "items": {
            "type": "string"
          }
        },
        "active": {
          "type": "boolean",
          "description": "Indica si el entrenador está habilitado para visitas y clases."
        },
        "createdByUid": {
          "type": "string",
          "description": "Identificador persistente del dispositivo o cliente origen que creó el registro.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdByEmail": {
          "type": "string",
          "format": "email",
          "description": "Correo técnico o corporativo de auditoría del registro.",
          "minLength": 5,
          "maxLength": 254,
          "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]{2,}$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Marca de tiempo generada por el servidor al crear el documento."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Marca de tiempo generada por el servidor en la última actualización."
        }
      },
      "required": [
        "name",
        "email",
        "phone",
        "avatar",
        "specialties",
        "active",
        "createdByUid",
        "createdByEmail",
        "createdAt",
        "updatedAt"
      ]
    },
    "Company": {
      "title": "Company",
      "description": "Empresa cliente con conexión automática multi-dispositivo (name, taxId, industry, logoText) y compatibilidad opcional con datos fiscales adicionales.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Razón social o nombre comercial de la empresa.",
          "minLength": 2,
          "maxLength": 150,
          "pattern": "^\\S(.*\\S)?$"
        },
        "taxId": {
          "type": "string",
          "description": "RFC o NIT de la empresa.",
          "minLength": 5,
          "maxLength": 25,
          "pattern": "^[A-Za-z0-9&Ññ][A-Za-z0-9&Ññ.\\- ]{3,23}[A-Za-z0-9&Ññ]$"
        },
        "industry": {
          "type": "string",
          "description": "Giro o industria de la empresa.",
          "minLength": 2,
          "maxLength": 100,
          "pattern": "^\\S(.*\\S)?$"
        },
        "logoText": {
          "type": "string",
          "description": "Siglas o identificador corto de la empresa (1 a 4 caracteres).",
          "minLength": 1,
          "maxLength": 4,
          "pattern": "^[A-Za-z0-9&Ññ]{1,4}$"
        },
        "companyName": {
          "type": "string",
          "description": "Alias opcional de razón social para compatibilidad de directorio.",
          "minLength": 2,
          "maxLength": 150,
          "pattern": "^\\S(.*\\S)?$"
        },
        "phone": {
          "type": "string",
          "description": "Teléfono corporativo opcional de la empresa.",
          "minLength": 0,
          "maxLength": 25
        },
        "primaryContactName": {
          "type": "string",
          "description": "Contacto corporativo principal opcional.",
          "minLength": 0,
          "maxLength": 120
        },
        "address": {
          "type": "object",
          "$ref": "#/entities/StructuredAddress",
          "description": "Dirección fiscal estructurada opcional de la empresa."
        },
        "createdByUid": {
          "type": "string",
          "description": "Identificador persistente del dispositivo o cliente origen que creó el registro.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdByEmail": {
          "type": "string",
          "format": "email",
          "description": "Correo técnico o corporativo de auditoría del registro.",
          "minLength": 5,
          "maxLength": 254,
          "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]{2,}$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Marca de tiempo generada por el servidor al crear el documento."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Marca de tiempo generada por el servidor en la última actualización."
        }
      },
      "required": [
        "name",
        "taxId",
        "industry",
        "logoText",
        "createdByUid",
        "createdByEmail",
        "createdAt",
        "updatedAt"
      ]
    },
    "Sede": {
      "title": "Sede",
      "description": "Sede / Campus / Planta autorizada de una empresa cliente con coordenadas GPS, geocerca y contacto.",
      "type": "object",
      "properties": {
        "companyId": {
          "type": "string",
          "description": "Identificador de la empresa propietaria en /companies/{companyId}.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "companyName": {
          "type": "string",
          "description": "Nombre comercial de la empresa a la que pertenece la sede.",
          "minLength": 2,
          "maxLength": 150,
          "pattern": "^\\S(.*\\S)?$"
        },
        "name": {
          "type": "string",
          "description": "Nombre de la sede, torre, planta o campus.",
          "minLength": 2,
          "maxLength": 150,
          "pattern": "^\\S(.*\\S)?$"
        },
        "address": {
          "type": "string",
          "description": "Dirección física completa de la sede.",
          "minLength": 3,
          "maxLength": 250,
          "pattern": "^\\S(.*\\S)?$"
        },
        "city": {
          "type": "string",
          "description": "Ciudad o entidad donde se ubica la sede.",
          "minLength": 2,
          "maxLength": 100,
          "pattern": "^\\S(.*\\S)?$"
        },
        "lat": {
          "type": "number",
          "description": "Latitud GPS oficial de la sede (-90 a 90)."
        },
        "lng": {
          "type": "number",
          "description": "Longitud GPS oficial de la sede (-180 a 180)."
        },
        "geofenceRadiusMeters": {
          "type": "number",
          "description": "Radio de geocerca permitido en metros (10 a 10000)."
        },
        "contactPerson": {
          "type": "string",
          "description": "Nombre de la persona de contacto en la sede.",
          "minLength": 2,
          "maxLength": 120,
          "pattern": "^\\S(.*\\S)?$"
        },
        "contactRole": {
          "type": "string",
          "description": "Cargo o puesto del contacto en sede.",
          "minLength": 2,
          "maxLength": 120,
          "pattern": "^\\S(.*\\S)?$"
        },
        "contactPhone": {
          "type": "string",
          "description": "Teléfono directo del contacto en sede.",
          "minLength": 7,
          "maxLength": 25,
          "pattern": "^[0-9+(][0-9+()\\- ]{5,23}[0-9)]$"
        },
        "colorTag": {
          "type": "string",
          "description": "Clase o identificador visual de color para la sede.",
          "minLength": 0,
          "maxLength": 40,
          "pattern": "^([a-zA-Z0-9_\\-]+)?$"
        },
        "createdByUid": {
          "type": "string",
          "description": "Identificador persistente del dispositivo o cliente origen que creó el registro.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdByEmail": {
          "type": "string",
          "format": "email",
          "description": "Correo técnico o corporativo de auditoría del registro.",
          "minLength": 5,
          "maxLength": 254,
          "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]{2,}$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Marca de tiempo generada por el servidor al crear el documento."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Marca de tiempo generada por el servidor en la última actualización."
        }
      },
      "required": [
        "companyId",
        "companyName",
        "name",
        "address",
        "city",
        "lat",
        "lng",
        "geofenceRadiusMeters",
        "contactPerson",
        "contactRole",
        "contactPhone",
        "createdByUid",
        "createdByEmail",
        "createdAt",
        "updatedAt"
      ]
    },
    "ClassAssignment": {
      "title": "ClassAssignment",
      "description": "Asignación programada de pausa activa o clase fitness sincronizada automáticamente entre dispositivos.",
      "type": "object",
      "properties": {
        "trainerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "trainerName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120,
          "pattern": "^\\S(.*\\S)?$"
        },
        "companyId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "companyName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 150,
          "pattern": "^\\S(.*\\S)?$"
        },
        "sedeId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "sedeName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 150,
          "pattern": "^\\S(.*\\S)?$"
        },
        "sedeAddress": {
          "type": "string",
          "minLength": 2,
          "maxLength": 250,
          "pattern": "^\\S(.*\\S)?$"
        },
        "frequency": {
          "type": "string",
          "enum": ["semanal", "mensual", "fecha_unica"],
          "maxLength": 20
        },
        "dayOfWeek": {
          "type": "number"
        },
        "date": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "dayOfMonth": {
          "type": "number"
        },
        "time": {
          "type": "string",
          "minLength": 5,
          "maxLength": 5,
          "pattern": "^[0-2][0-9]:[0-5][0-9]$"
        },
        "durationMinutes": {
          "type": "number"
        },
        "activityType": {
          "type": "string",
          "enum": ["pausa_activa", "clase_fitness"],
          "maxLength": 20
        },
        "activityName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 150,
          "pattern": "^\\S(.*\\S)?$"
        },
        "locationArea": {
          "type": "string",
          "minLength": 1,
          "maxLength": 150,
          "pattern": "^\\S(.*\\S)?$"
        },
        "expectedAttendees": {
          "type": "number"
        },
        "notes": {
          "type": "string",
          "maxLength": 500
        },
        "active": {
          "type": "boolean"
        },
        "closed": {
          "type": "boolean"
        },
        "closedAt": {
          "type": "string",
          "maxLength": 40
        },
        "completedDates": {
          "type": "array"
        },
        "nonCompliant": {
          "type": "boolean"
        },
        "nonCompliantReason": {
          "type": "string",
          "enum": ["fuera_de_horario", "sin_cierre_30m", "manual_admin"],
          "maxLength": 30
        },
        "nonCompliantAt": {
          "type": "string",
          "maxLength": 40
        },
        "missedDates": {
          "type": "array"
        },
        "reopenedDates": {
          "type": "array"
        },
        "createdByUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdByEmail": {
          "type": "string",
          "format": "email",
          "minLength": 5,
          "maxLength": 254,
          "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]{2,}$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "trainerId",
        "trainerName",
        "companyId",
        "companyName",
        "sedeId",
        "sedeName",
        "sedeAddress",
        "frequency",
        "time",
        "activityType",
        "activityName",
        "locationArea",
        "active",
        "createdByUid",
        "createdByEmail",
        "createdAt",
        "updatedAt"
      ]
    },
